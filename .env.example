# =============================================================================
# Algohns V12 — environment configuration
# Copy this file to `.env` and fill in your own values. Never commit `.env`.
# =============================================================================

# --- Alpaca (Module 2) — PAPER TRADING ONLY ----------------------------------
# Get these at app.alpaca.markets while switched to *Paper* trading:
#   Home -> API Keys -> Generate. The Key ID starts with "PK"; the Secret is
#   shown exactly once. Put the Key ID in ALPACA_API_KEY and the Secret in
#   ALPACA_SECRET_KEY. Never commit real values — this file is tracked in git
#   and the repository is public.
ALPACA_API_KEY=your-paper-key-id-here
ALPACA_SECRET_KEY=your-paper-secret-key-here
ALPACA_PAPER=true
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_BASE_URL=https://data.alpaca.markets

# --- Async worker (Module 2) -------------------------------------------------
REDIS_URL=redis://localhost:6379/0
# Optional explicit overrides (default to REDIS_URL):
# CELERY_BROKER_URL=
# CELERY_RESULT_BACKEND=

# --- Automated trading (background worker) ------------------------------------
# OFF by default: `docker compose up` monitors the account but does NOT trade.
# Set this to true to let the worker rebalance the PAPER account on a schedule.
ALGO_AUTO_REBALANCE=false
# When to rebalance (5-field cron, UTC). Default 14:35 UTC weekdays (~5 min
# after the US cash open). The task also checks the live market clock.
ALGO_REBALANCE_CRON=35 14 * * 1-5
# Which allocation to hold. Either a preset name...
#   balanced | growth | conservative | all_weather | global_equity
ALGO_STRATEGY=balanced
# ...or an explicit allocation as JSON (wins over ALGO_STRATEGY if set):
# ALGO_TARGET_WEIGHTS={"SPY": 0.6, "AGG": 0.4}
# How often to read the account for the monitoring log (seconds).
ALGO_SYNC_INTERVAL=300

# --- Live code editor (Strategy Lab / Backtest / Curves / World Sim) ----------
# The "🐍 Code" tabs have editable code cells. Editing is ALWAYS on; RUNNING the
# edited code is opt-in. OFF by default so a PUBLIC deployment cannot be turned
# into an arbitrary-code console. Set this to true when running the app on your
# own machine / Docker (or a private deployment) to enable the ▶ Run button.
ALGO_ALLOW_CODE_EXEC=false

# --- SEC EDGAR (Modules 4 & 5) -----------------------------------------------
# SEC requires a descriptive User-Agent with a real contact email.
SEC_USER_AGENT=Algohns Research your.email@example.com

# --- Tax defaults (Module 1) -------------------------------------------------
DEFAULT_TAX_RESIDENCE=IT
