# ---------------------------------------------------------------------------
# Copy to platform/.env and fill in. Never commit the filled-in file.
# ---------------------------------------------------------------------------

# --- Alpaca (PAPER ONLY) ----------------------------------------------------
# The platform refuses any non-paper host at the client level: see
# alpaca_execution.require_paper(). Changing ALPACA_BASE_URL to the live
# endpoint does not enable live trading, it raises LiveTradingBlocked.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_BASE_URL=https://data.alpaca.markets

# --- SEC EDGAR --------------------------------------------------------------
# MANDATORY and must contain a real contact address. EDGAR returns 403 for
# generic user agents, and the platform refuses to send one.
SEC_USER_AGENT=algohns-research/1.0 (tua.email@dominio.it)
SEC_RATE_LIMIT=8.0

# --- Async workers ----------------------------------------------------------
# apscheduler: in-process, no broker, dies with the process. Fine for one node.
# celery:      needs Redis, survives restarts, retries, multiple workers.
SCHEDULER_BACKEND=apscheduler
REDIS_URL=redis://localhost:6379/0

# --- Cache ------------------------------------------------------------------
CACHE_TTL_SECONDS=21600
